<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gallery.exe"
        Arguments=""
        InstallLocation="C:\Program Files\dresdof\One File Optimized Photo Gallery">
    </Installer>
    <PackageInformation
        PackageName="One File Optimized Photo Gallery"
        PackageDisplayName="One File Optimized Photo Gallery"
        PublisherName="CN=dresdof"
        PublisherDisplayName="dresdof"
        Version="0.1.0.0"
        PackageDescription="A photo gallery that ships as one self-contained file">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dresdof.gallery"
                Description="A photo gallery that ships as one self-contained file"
                DisplayName="One File Optimized Photo Gallery"
                ExecutableName="gallery.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>One File Optimized Photo Gallery</DisplayName>
            <PublisherDisplayName>dresdof</PublisherDisplayName>
            <Description>A photo gallery that ships as one self-contained file</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gallery.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
