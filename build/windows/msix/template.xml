<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wails-gallery.exe"
        Arguments=""
        InstallLocation="C:\Program Files\dresdof\photo-gallery">
    </Installer>
    <PackageInformation
        PackageName="photo-gallery"
        PackageDisplayName="photo-gallery"
        PublisherName="CN=dresdof"
        PublisherDisplayName="dresdof"
        Version="0.1.0.0"
        PackageDescription="A wails-gallery application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dresdof.wailsgallery"
                Description="A wails-gallery application"
                DisplayName="photo-gallery"
                ExecutableName="wails-gallery.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>photo-gallery</DisplayName>
            <PublisherDisplayName>dresdof</PublisherDisplayName>
            <Description>A wails-gallery application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="wails-gallery.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
