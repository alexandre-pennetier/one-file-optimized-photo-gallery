{
  "name": "wails-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "optimize": "node scripts/optimize-photos.mjs",
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.2.2",
    "vite": "^8.0.5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
